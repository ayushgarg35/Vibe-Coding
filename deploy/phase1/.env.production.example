# ─────────────────────────────────────────────────────────────────
# Production Environment — copy to .env.production and fill in
# NEVER commit .env.production to git
# ─────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────
APP_ENV=production
APP_SECRET_KEY=                    # openssl rand -hex 32
APP_BASE_URL=https://your-domain.com
CORS_ORIGINS=["https://your-domain.com"]

# ── Database ─────────────────────────────────────────────────────
POSTGRES_USER=pmuser
POSTGRES_PASSWORD=                 # openssl rand -hex 24
POSTGRES_DB=agenticpm
DATABASE_URL=postgresql+asyncpg://pmuser:YOURPASSWORD@postgres:5432/agenticpm

# ── Redis ────────────────────────────────────────────────────────
REDIS_PASSWORD=                    # openssl rand -hex 24
REDIS_URL=redis://:YOURPASSWORD@redis:6379/0

# ── Vector Store ─────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# ── LLM Providers (fill at least one) ───────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
LITELLM_MASTER_KEY=                # openssl rand -hex 32

# ── Auth (Clerk) ──────────────────────────────────────────────────
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# ── Object Storage ────────────────────────────────────────────────
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=                     # openssl rand -hex 16
S3_SECRET_KEY=                     # openssl rand -hex 32
S3_BUCKET_NAME=agentic-pm
S3_REGION=us-east-1

# ── Observability ─────────────────────────────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-pm-prod
LANGSMITH_TRACING=true

# ── Compliance ────────────────────────────────────────────────────
DEFAULT_DATA_REGION=US
PII_DETECTION_ENABLED=true
AUDIT_LOG_ENABLED=true

# ── Frontend ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://your-domain.com
NEXT_PUBLIC_WS_URL=wss://your-domain.com

# ── Docker image config ───────────────────────────────────────────
REGISTRY=ghcr.io/ayushgarg35
IMAGE_TAG=latest
